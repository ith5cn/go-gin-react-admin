SERVER_ADDR=:8080
ROUTER_PREFIX=/api/v1

# When the server runs in Docker and MySQL runs on your host machine,
# use host.docker.internal instead of 127.0.0.1.
AI_SYSTEM_MYSQL_HOST=host.docker.internal
AI_SYSTEM_MYSQL_PORT=3306
AI_SYSTEM_MYSQL_USER=root
AI_SYSTEM_MYSQL_PASSWORD=your_local_password
AI_SYSTEM_MYSQL_DB=ai_system
AI_SYSTEM_MYSQL_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

MYSQL_LOG_LEVEL=info
MYSQL_MAX_IDLE_CONNS=10
MYSQL_MAX_OPEN_CONNS=100
MYSQL_CONN_MAX_LIFETIME_MINUTE=60

REDIS_MODE=single
REDIS_ADDR=host.docker.internal:6379
REDIS_ADDRS=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_SECRET=change_me_for_local_dev
JWT_ISSUER=gin-react-admin
JWT_ACCESS_EXPIRES_MINUTE=120
JWT_REFRESH_EXPIRES_HOUR=24
JWT_LOGIN_MODE=multi

LOG_MODE=dev
LOG_LEVEL=debug

# Opt in on exactly one instance per database; other HTTP replicas stay disabled.
CRON_ENABLED=false
