SERVER_ADDR=:8080
ROUTER_PREFIX=/api/v1

AI_SYSTEM_MYSQL_HOST=your-production-mysql-host
AI_SYSTEM_MYSQL_PORT=3306
AI_SYSTEM_MYSQL_USER=your-production-user
AI_SYSTEM_MYSQL_PASSWORD=your-production-password
AI_SYSTEM_MYSQL_DB=ai_system
AI_SYSTEM_MYSQL_CONFIG=charset=utf8mb4&parseTime=True&loc=Local

MYSQL_LOG_LEVEL=warn
MYSQL_MAX_IDLE_CONNS=10
MYSQL_MAX_OPEN_CONNS=100
MYSQL_CONN_MAX_LIFETIME_MINUTE=60

REDIS_MODE=single
REDIS_ADDR=your-production-redis-host:6379
REDIS_ADDRS=
REDIS_PASSWORD=your-production-redis-password
REDIS_DB=0
REDIS_TLS=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=gin-react-admin
JWT_ACCESS_EXPIRES_MINUTE=120
JWT_REFRESH_EXPIRES_HOUR=24
JWT_LOGIN_MODE=multi

LOG_MODE=prod
LOG_LEVEL=info

# Opt in on exactly one instance per database; other HTTP replicas stay disabled.
CRON_ENABLED=false
